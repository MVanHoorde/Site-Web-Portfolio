# Configuration locale d'outils (ne concerne pas le site publié)
.claude/

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
*.swp
*~

# Dossiers de travail temporaires
/tmp/
*.log

# Base de données — sauvegardes : contiennent des données d'élèves.
# Ne JAMAIS committer. Les dumps vivent sur le disque de Loïc + copie externe.
/sauvegardes/
*.dump
*.backup
dump-*.sql

# Secrets Supabase (jetons d'accès, mot de passe de base, clé service_role)
.env
*.env
supabase/.temp/

# Corrigés élèves — imprimé et PDF individuel uniquement, jamais en ligne
/_corriges-cfa/
# Corrigés des questions ouvertes d'ES — corrigées en classe, jamais en ligne
/_corriges-es/

# Documents d'examen — ne JAMAIS committer.
# GitHub Pages est public par construction, y compris un dossier non référencé.
/cfa-prive/
*grille-jury*
*version-jury*

# Archives de livraison (delta) — restent sur le disque de Loic
livraison-*.zip

# Dossier de travail : sujets bruts DS/TP (docx, corrections, donnees de classe).
# Seuls les PDF de sujet triés rejoignent assets/pdf/pc/ — jamais ce dossier.
/_a-deposer/

# Aperçus de contrôle produits pendant un audit (captures mesurées).
# Ils servent à la passe en cours, pas au site : ils restent sur le disque.
/_apercus-*/

# Cache Python du generateur de fiches — regenere a chaque execution
__pycache__/
*.pyc

# Fichiers verrou d'Office (~$nom.pptx) : créés dès qu'un document est ouvert,
# supprimés à la fermeture. Depuis que le dépôt porte des .pptx, ils peuvent
# apparaître à tout moment dans le statut.
~$*
