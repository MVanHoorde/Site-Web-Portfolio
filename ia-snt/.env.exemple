# Modèle de configuration du worker de pré-correction SNT.
# Copie ce fichier en  .env  (dans ce dossier ia-snt/) et renseigne
# les valeurs. Le vrai .env est ignoré par git (voir .gitignore) :
# la clé service_role NE DOIT JAMAIS être commitée ni mise dans une page.

# Project URL — Supabase → Settings → Data API (ou API) → Project URL.
# SANS le /rest/v1 à la fin.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé service_role — Supabase → Settings → API Keys → « service_role · secret ».
# ⚠ Elle contourne TOUTES les règles RLS. Elle vit uniquement ici, sur ton PC.
SUPABASE_SERVICE_ROLE=colle-ici-la-cle-service_role-secrete

# --- Modèle local (facultatif) ---------------------------------------
# Le worker fonctionne sans ces deux lignes (défauts ci-dessous).
# Changer de modèle un jour = changer CETTE ligne, rien d'autre.
IA_MODELE=mistral-nemo
# OLLAMA_URL=http://localhost:11434
