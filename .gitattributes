# Normalisation des fins de ligne : Git stocke en LF, restitue selon l'OS.
# Met fin aux faux diffs CRLF/LF entre Windows et GitHub.
* text=auto eol=lf

# Fichiers binaires : jamais de conversion de fin de ligne.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pdf   binary
*.pptx  binary
*.docx  binary
*.m4a   binary
*.mp3   binary
*.mp4   binary
*.ico   binary
