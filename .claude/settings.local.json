{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(diff:*)",
      "Bash(comm:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(md5sum:*)",
      "Bash(find:*)",
      "Bash(for:*)",
      "Bash(curl -s:*)",
      "Bash(curl -sf:*)",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "Bash(git add *)",
      "Bash(git commit -q -m ' *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)",
      "Bash(gh repo delete:*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
